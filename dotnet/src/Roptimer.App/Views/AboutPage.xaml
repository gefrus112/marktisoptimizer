<Page x:Class="Roptimer.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="850"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,8,24">
            <TextBlock Text="About" Style="{StaticResource TitleText}" />
            <Grid Margin="0,14,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/RoptimerShield.png" Width="150" Height="150" />
                        <TextBlock Text="ROPTIMER HUB" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="V3.2.0 • .NET 8 WPF" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WHAT THIS IS" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Roptimer Hub V3.2 is a safe Roblox performance bootstrapper built in C#/.NET 8. Its settings-window layout is inspired by Bubblestrap/Bloxstrap-style WPF navigation, but this is an original dependency-free implementation with a different shield icon and a strict local-settings-only feature set." />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="It discovers Roblox version folders, writes only the 18 canonical allowlisted ClientAppSettings.json flags, creates backups, restores managed keys, quarantines old log/temp files, detects OS-level client metadata, and launches Roblox through roblox://." />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="It does not inject DLLs, modify memory, disable Roblox telemetry/Crashpad/Backtrace, add fullbright/x-ray, remove buildings, bypass anti-cheat, or automate gameplay." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Open GitHub" Tag="https://github.com/gefrus112/marktisoptimizer" Click="OpenLink_Click" />
                            <Button Content="Bubblestrap reference" Tag="https://github.com/ItzBloxxy/Bubblestrap" Click="OpenLink_Click" />
                            <Button Content="Roblox allowlist" Tag="https://devforum.roblox.com/t/allowlist-for-local-client-configuration-via-fast-flags/3966569" Click="OpenLink_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WINDOWS COMMANDS" Style="{StaticResource SectionText}" />
                    <TextBox IsReadOnly="True" AcceptsReturn="True" Height="120" Margin="0,10,0,0" FontFamily="Consolas" Text="RoptimerBoost.exe open&#x0a;RoptimerBoost.exe bootstrap --launch&#x0a;RoptimerBoost.exe preview --mode &quot;Reduce building lag&quot; --tier 21 --texture 0&#x0a;RoptimerBoost.exe restore&#x0a;RoptimerBoost.exe allowlist&#x0a;RoptimerBoost.exe cache-clean --days 7 --force" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SOURCES" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Roblox FastFlag allowlist announcement; Roblox QualityLevel enum; Roblox graphics quality help; allowlisted FastFlags community guide; Roblox performance stats documentation. No third-party code from Bubblesstrap is copied—its open-source WPF layout is used only as visual inspiration." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
