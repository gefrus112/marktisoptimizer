<Page x:Class="Roptimer.App.Views.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="850"
      Background="Transparent" Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,8,24">
            <TextBlock Text="FastFlags" Style="{StaticResource TitleText}" />
            <TextBlock Text="Only allowlisted local flags are managed. This page shows the exact JSON that will be written to ClientAppSettings.json." Style="{StaticResource MutedText}" Margin="0,6,0,14" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,12">
                    <StackPanel>
                        <TextBlock Text="GENERATED FLAGS" Style="{StaticResource SectionText}" />
                        <TextBox x:Name="JsonBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="360" Margin="0,10,0,0" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Refresh" Click="Refresh_Click" />
                            <Button Content="Copy JSON" Click="Copy_Click" />
                            <Button Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MANAGED FLAG MATRIX" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                        <DataGrid x:Name="FlagGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Flag" Binding="{Binding Flag}" Width="2.2*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="0.7*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource MutedText}" Text="Feature audit: Unlocking FPS is legacy and may be ignored. Texture and cache alterations are implemented as texture tiers 0-3 plus conservative old log/temp quarantine. Disabling Crashpad, Backtrace, telemetry, or background screenshot uploads is rejected. Extended graphic tiers 0-21 are implemented through DFIntDebugFRMQualityLevelOverride." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
