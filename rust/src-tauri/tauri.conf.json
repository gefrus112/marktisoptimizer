{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marktis Optimizer",
  "version": "4.0.0",
  "identifier": "com.roptimer.client",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Marktis Optimizer — Windows Client",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#090d13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Marktis Optimizer — safe Roblox settings",
    "longDescription": "Marktis Optimizer is a Rust + Tauri Windows client that detects Roblox, displays read-only local hardware details, manages reversible allowlisted settings, and supports user-configured WireGuard tunnels from provider-supplied profiles through the official Windows client. It does not provide VPN service or servers.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "startMenuFolder": "Marktis Optimizer"
      }
    }
  }
}
