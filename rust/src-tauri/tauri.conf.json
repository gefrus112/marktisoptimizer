{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roptimer",
  "version": "4.0.0",
  "identifier": "com.roptimer.client",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Roptimer — Windows Client",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#030307"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Safe, reversible Roblox performance settings",
    "longDescription": "A lightweight Rust + Tauri Windows client that detects your Roblox installation on first launch and manages only Roblox-allowlisted, reversible ClientAppSettings.json performance flags.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
